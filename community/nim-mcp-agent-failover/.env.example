# Get a free key at https://build.nvidia.com (starts with nvapi-). Never commit the real one.
NVIDIA_API_KEY=nvapi-your-key-here

# Where the OpenAI-compatible API lives. Change this one line to go from hosted to local.
#   Hosted NIM (default):        https://integrate.api.nvidia.com/v1
#   Self-hosted NIM container:   http://localhost:8000/v1
#   Any OpenAI-compatible server (Ollama, vLLM, llama.cpp, MLX): its /v1 URL
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: pin a model. Leave unset to let the kit discover one from /v1/models.
# NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Nothing loads this file automatically. Either:
#   set -a; . ./.env; set +a          (then run any command)
#   node --env-file=.env router/nim-route.mjs models
